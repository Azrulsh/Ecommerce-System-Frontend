# Server-only Laravel API URL, including /api. Required in production.
# Remote production services must use HTTPS; loopback HTTP supports local verification.
LARAVEL_API_URL=http://127.0.0.1:8000/api

# API_BASE_URL remains a deprecated fallback for existing PoC environments.
# If both variables exist, LARAVEL_API_URL takes precedence.

# Exact browser origin. Use your HTTPS origin on a remote deployment.
APP_ORIGIN=http://localhost:3000
# This implementation requires one Node host with durable private disk.
SESSION_DEPLOYMENT=single-host
# HTTPS document responses enable nonce CSP, HSTS and insecure-request upgrades.
# See docs/deployment.md; TLS, proxy caching and Windows ACLs need target validation.
# Production: absolute path on a private durable volume OUTSIDE all web roots.
# SESSION_STORE_DIRECTORY=<private external directory>
# Production REQUIRES a random 32-byte base64 key from your secret manager.
# SESSION_ENCRYPTION_KEY=<provide privately; never commit a real key>
# Development defaults to a private per-project directory under the user temp directory.
# Its random development key persists there. Never use that default for production.
# Checkout keys and unresolved-attempt recovery also depend on this directory/key.
# Preserve both across deployments and restore them together; never prune active attempts.
